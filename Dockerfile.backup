# =============================================================================
# Bu dosya ne ise yarar?
#   Yedek/restore Job'larinin kullandigi image: pg_dump, redis-cli, openssl, curl...
#   Ornek: docker build -t safepoint-backup:dev -f Dockerfile.backup .
# =============================================================================

FROM alpine:3.20
RUN apk add --no-cache \
      bash curl ca-certificates gzip openssl \
      postgresql16-client \
      redis \
      mariadb-client \
    && adduser -D -u 65532 nonroot
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/bin/bash"]
